{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/kiro-claude-haiku-4.5",
  "skills": {
    "paths": [
      "~/.pi/agent/skills"
    ]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "kubectl delete *": "deny",
      "terraform destroy *": "deny",
      "git push --force *": "deny",
      "rm -rf ~*": "deny",
      "rm -rf /*": "deny"
    },
    "edit": {
      "*": "allow",
      "~/.terraformrc": "deny"
    },
    "read": {
      "**": "allow",
      "~/.terraformrc": "deny"
    },
    "write": {
      "*": "allow",
      "~/.terraformrc": "deny"
    },
    "external_directory": {
      "~/.terraformrc": "deny",
      "**": "allow"
    }
  },
  "mcp": {
    "grafana": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-grafana"
      ],
      "environment": {
        "GRAFANA_URL": "{env:GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      },
      "enabled": false
    },
    "slack": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "slack-mcp-server@latest",
        "--transport",
        "stdio"
      ],
      "environment": {
        "SLACK_MCP_XOXP_TOKEN": "{env:SLACK_MCP_XOXP_TOKEN}",
        "SLACK_MCP_ADD_MESSAGE_TOOL": "true"
      },
      "enabled": false
    },
    "excalidraw": {
      "type": "remote",
      "url": "https://mcp.excalidraw.com",
      "enabled": false
    }
  },
  "plugin": [
    "@tarquinen/opencode-smart-title",
    "@bastiangx/opencode-unmoji",
    "opencode-see-image@1.2.5",
    "magic-compact",
    "@bogyie/opencode-kiro-plugin",
    "caveman-opencode-plugin@latest"
  ],
  "provider": {
    "kiro": {
      "options": {
        "backend": "fetch",
        "region": "us-east-1"
      }
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "model": "deepseek/deepseek-flash",
  "skills": {
    "paths": ["~/.pi/agent/skills"]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "kubectl delete *": "deny",
      "terraform destroy *": "deny",
      "git push --force *": "deny",
      "rm -rf ~*": "deny",
      "rm -rf /*": "deny"
    },
    "edit": {
      "*": "allow",
      "~/.terraformrc": "deny"
    },
    "read": {
      "**": "allow",
      "~/.terraformrc": "deny"
    },
    "write": {
      "*": "allow",
      "~/.terraformrc": "deny"
    },
    "external_directory": {
      "~/.terraformrc": "deny",
      "**": "allow"
    }
  },
  "mcp": {
    "grafana": {
      "type": "local",
      "command": ["uvx", "mcp-grafana"],
      "environment": {
        "GRAFANA_URL": "{env:GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      },
      "enabled": false
    },
    "slack": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "slack-mcp-server@latest",
        "--transport",
        "stdio"
      ],
      "environment": {
        "SLACK_MCP_XOXP_TOKEN": "{env:SLACK_MCP_XOXP_TOKEN}",
        "SLACK_MCP_ADD_MESSAGE_TOOL": "true"
      },
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"]
    },
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "environment": {
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
        "CONFLUENCE_URL": "{env:CONFLUENCE_URL}",
        "CONFLUENCE_USERNAME": "{env:CONFLUENCE_USERNAME}",
        "CONFLUENCE_API_TOKEN": "{env:CONFLUENCE_API_TOKEN}"
      }
    },
    "excalidraw": {
      "type": "remote",
      "url": "https://mcp.excalidraw.com",
      "enabled": false
    },
    "shiori": {
      "type": "remote",
      "url": "https://www.shiori.sh/mcp"
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "plugins": [
    {
      "package": "@plannotator/opencode@latest",
      "options": {
        "workflow": "plan-agent",
        "planningAgents": ["plan"]
      }
    },
    "opencode-gpt-live"
  ],
  "providers": {
    "kiro": {
      "name": "Kiro",
      "package": "aisdk:kiro-acp-ai-provider",
      "settings": {
        "trustAllTools": false
      },
      "models": {
        "auto": {
          "name": "Auto (Kiro)",
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5 (Kiro)",
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5 (Kiro)",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra (Kiro)",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (Kiro)",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6 (Kiro)",
          "limit": {
            "context": 1000000,
            "output": 16384
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "claude-haiku-4.5": {
          "name": "Claude Haiku 4.5 (Kiro)",
          "limit": {
            "context": 200000,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}

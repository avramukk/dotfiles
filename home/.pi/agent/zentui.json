  "gitBranch": {
    "maxLength": "full"
  },
  "responsiveFooter": true,
  "compactFooterMaxLines": 1,
  "components": {
    "editor": {
      "enabled": true,
      "style": "minimalist",
      "codexQuota": false,
      "colorSource": "terminal",
      "borderColorMode": "static",
      "modelLabel": "id",
      "viewportIndicators": false,
      "styles": {
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)(  $codex_quota)",
          "completionMenu": "native"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)(  $codex_quota)",
          "completionMenu": "palette"
        },
        "accent-rail": {
          "rail": "▎",
          "asciiRail": "|",
          "transparent": false
        },
        "minimalist": {
          "pathDisplay": "full",
          "contextFormat": "percent",
          "contextGauge": false,
          "showSessionName": true,
          "showTimer": false,
          "showCost": false,
          "showGit": false,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          }
        }
      }
    },
    "footer": {
      "style": "hidden",
      "codexQuota": false,
      "colorSource": "theme",
      "modelLabel": "id",
      "styles": {
        "starship": {
          "format": "",
          "responsive": true,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens$wrap_sep($codex_quota)",
          "compactMaxLines": 1,
          "separator": "none",
          "contextStyle": "gauge",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "repository",
            "depth": 3
          },
          "segments": {
            "cwd": true,
            "sessionName": true,
            "gitBranch": true,
            "gitStatus": true,
            "gitCounts": false,
            "gitCommit": false,
            "gitMetrics": false,
            "runtime": false,
            "modelInfo": true,
            "context": true,
            "tokens": false,
            "cost": false,
            "sessionDuration": false,
            "username": false,
            "time": true,
            "os": false,
            "packageVersion": false
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "right",
            "placements": {
              "authority": "off",
              "caveman": "off",
              "mcp": "middle",
              "cursor": "off",
              "session-name": "right"
            },
            "colorModes": {
              "authority": "zentui",
              "mcp": "zentui"
            }
          }
        }
      }
    },
    "userMessages": {
      "enabled": false,
      "style": "compact",
      "colorSource": "theme",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      }
    },
    "selectorBorders": {
      "enabled": false,
      "style": "zentui",
      "colorSource": "theme"
    },
    "thinkingSteps": {
      "enabled": true,
      "mode": "tree"
    },
    "workingLine": {
      "enabled": false,
      "turnSummary": true,
      "spinner": "braille",
      "spinnerIntervalMs": 60,
      "animateSpinnerColor": false,
      "textIntervalMs": 60,
      "textAnimation": "disabled",
      "colorSource": "theme",
      "messages": {
        "custom": true,
        "values": [
          "Sautéing…",
          "Cooking…",
          "Ionizing…",
          "Zigzagging…",
          "Razzle-dazzling…",

{
  "lastChangelogVersion": "0.87.1",
  "theme": "gruvbox-dark-hard-custom",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "low",
  "modelThinkingLevels": {
    "deepseek/deepseek-flash": "low"
  },
  "packages": [
    "git:https://github.com/hasit/pi-community-themes",
    "npm:pi-zentui",
    "npm:pi-mcp-adapter",
    "npm:@counterposition/pi-web-search",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@upstash/context7-pi",
    "npm:@roodriigoooo/pi-hunk",
    "npm:@narumitw/pi-btw",
    "npm:@plannotator/pi-extension",
    "npm:betterwright"
  ],
  "editorPaddingX": 1,
  "quietStartup": false,
  "enableInstallTelemetry": false,
  "treeFilterMode": "default",
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "transport": "auto",
  "followUpMode": "one-at-a-time",
  "outputPad": 1,
  "terminal": {
    "clearOnShrink": false,
    "showTerminalProgress": false
  },
  "steeringMode": "one-at-a-time",
  "tuiMode": "fullscreen",
  "markdown": {
    "mermaid": "streaming"
  },
  "enabledModels": ["deepseek/deepseek-flash"],
  "showHardwareCursor": false
}

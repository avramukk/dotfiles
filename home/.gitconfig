[user]
	# Set via ~/.gitconfig.local — not tracked in dotfiles
	# email = your@email.com
	# name = Your Name

[include]
	path = ~/.gitconfig.local
[pull]
	rebase = true
[core]
	excludesfile = /Users/kolia/.gitignore_global
	fsmonitor = true
	preloadindex = true
	fscache = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
